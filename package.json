{
  "name": "rutina",
  "productName": "Rutina",
  "version": "0.22.1",
  "description": "Tu comida, tu compra y tus entrenos en un solo sitio.",
  "author": "Rutina",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/logic.test.mjs && node test/objetivo.test.mjs",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "test:e2e": "node test/e2e/run.cjs",
    "test:all": "npm test && node test/e2e/run.cjs --semana"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.rutina.desktop",
    "productName": "Rutina",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.healthcare-fitness",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "extendInfo": {
        "NSCameraUsageDescription": "Rutina usa la cámara solo para leer códigos de barras de productos."
      }
    },
    "dmg": {
      "title": "Rutina"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "artifactName": "Rutina-${os}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "charlymanso",
      "repo": "rutina"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
